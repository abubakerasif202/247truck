NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_INVENTORY_APP_URL=http://localhost:3100
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Set to true ONLY when SUPABASE_TEST_* points at a local/disposable inventory stack.
# Integration tests create and delete Auth users and refuse to run without this.
SUPABASE_TEST_ALLOW_DESTRUCTIVE=false

# Server-only invoice delivery. Delivery remains disabled unless explicitly enabled.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
INVOICE_EMAIL_DELIVERY_ENABLED=false

# Adelaide Wholesale Tyres server-to-server inventory integration. Never expose
# either secret to browsers and configure the same client ID/secret in Adelaide.
AWT_INVENTORY_CLIENT_ID=
AWT_INVENTORY_CLIENT_SECRET=
# The 247 location whose new-tyre stock is sellable through Adelaide Wholesale Tyres.
AWT_INVENTORY_LOCATION_ID=

# Vercel Cron authorization for expired checkout-hold cleanup.
CRON_SECRET=
