# Server-only email delivery for franchise and fleet enquiries.
RESEND_API_KEY=re_your_server_only_key
ENQUIRY_TO_EMAIL=admin@247trucktyreservices.com.au
ENQUIRY_FROM_EMAIL=24/7 Truck Tyre Services <enquiries@247trucktyreservices.com.au>

# Server-only Supabase persistence. Never expose the service-role key to browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Booking email settings fall back to ENQUIRY_* when omitted.
BOOKING_ADMIN_EMAIL=admin@247trucktyreservices.com.au
BOOKING_FROM_EMAIL=24/7 Truck Tyre Services <bookings@247trucktyreservices.com.au>
NEXT_PUBLIC_SITE_URL=https://www.247trucktyreservices.com.au

# Membership email settings fall back to ENQUIRY_* when omitted.
MEMBERSHIP_ADMIN_EMAIL=admin@247trucktyreservices.com.au
MEMBERSHIP_FROM_EMAIL=24/7 Truck Tyre Services <memberships@247trucktyreservices.com.au>
MEMBERSHIP_ACTIVATION_SECRET=replace_with_at_least_32_random_characters
